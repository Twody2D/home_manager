# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

ENVIRONMENT=development

# --- Database ---
POSTGRES_USER=home_manager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=home_manager
DATABASE_URL=postgresql+asyncpg://home_manager:change-me@postgres:5432/home_manager

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- AI assistant ---
# "mock" needs no API key and is fine for local dev; switch to "gemini" and
# set GEMINI_API_KEY to use the real model.
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# --- Web push notifications ---
# Leave both blank to disable push entirely (subscribe/send become no-ops).
# Generate with: cd backend && uv run python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
